# Variables de ejemplo (valores ficticios). Copia este archivo a .env y cambia los valores por los reales.
# .env NO se sube a git. En Cloudflare Pages estas mismas variables se definen en el panel.

# Obligatorias
SITIO_WHATSAPP=573000000000
SITIO_DOMINIO=https://spa-ejemplo.example.com
SITIO_CIUDAD=Ciudad Ejemplo
SITIO_DIRECCION=Calle 1 No. 2-3
SITIO_HORARIO_LV=8:00 a. m. - 6:00 p. m.
SITIO_HORARIO_SAB=9:00 a. m. - 1:00 p. m.
SITIO_HORARIO_DOM=Cerrado

# Opcionales (si faltan, no se muestran)
SITIO_INSTAGRAM=https://instagram.com/spa.ejemplo
SITIO_FACEBOOK=https://facebook.com/spa.ejemplo
SITIO_TIKTOK=https://tiktok.com/@spa.ejemplo
# SITIO_MAPA_URL=https://www.google.com/maps/embed?pb=...
